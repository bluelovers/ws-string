{
  "name": "reserved2",
  "version": "0.1.7",
  "description": "Reserved words that may not be used as variables, functions, methods, or object identifiers, since ECMAScript specifies special behavior for them.",
  "keywords": [
    "reserved",
    "words",
    "javascript",
    "ECMAScript",
    "create-by-yarn-tool",
    "create-by-tsdx"
  ],
  "homepage": "https://github.com/bluelovers/ws-string/tree/master/packages/reserved#readme",
  "bugs": {
    "url": "https://github.com/bluelovers/ws-string/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bluelovers/ws-string.git",
    "directory": "packages/reserved"
  },
  "license": "ISC",
  "licenses": [
    {
      "type": "MIT",
      "url": "https://github.com/jonschlinkert/reserved/blob/master/LICENSE-MIT"
    }
  ],
  "author": "Jon Schlinkert (https://github.com/jonschlinkert)",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.esm.mjs"
    },
    "./package.json": "./package.json",
    "./src/*": "./src/*"
  },
  "main": "dist/index.cjs",
  "unpkg": "dist/index.umd.production.min.cjs",
  "module": "dist/index.esm.mjs",
  "types": "dist/index.d.ts",
  "typings": "dist/index.d.ts",
  "scripts": {
    "coverage": "pnpm run test --coverage",
    "test": "jest --passWithNoTests",
    "test:jest": "jest --passWithNoTests",
    "test:jest:coverage": "node --run test:jest -- --coverage",
    "test:jest:snapshot": "node --run test:jest -- -u",
    "test:snapshot": "pnpm run test -u",
    "test:tsd": "ynpx tsd",
    "posttest": "pnpm run build",
    "build": "pnpm run build:tsdx && pnpm run build:dts:bundle",
    "build:dts:bundle": "ynpx @bluelovers/dts-bundle-generator -o ./dist/index.d.ts ./src/index.ts --no-banner --inline-declare-global & echo build:dts:bundle",
    "build:dts:copy": "copy .\\src\\index.d.ts .\\dist\\index.d.ts & echo build:dts",
    "build:dts:tsc": "pnpm run build:dts:copy && pnpm run build:dts:tsc:emit && pnpm run build:dts:copy",
    "build:dts:tsc:emit": "tsc --emitDeclarationOnly --declaration --noEmit false",
    "build:tsdx": "ynpx @bluelovers/tsdx build --target node",
    "ci:install": "echo ci:install",
    "ci:build": "echo ci:build",
    "preversion": "echo preversion && pnpm run test",
    "version": "echo version",
    "prepublishOnly": "echo prepublishOnly",
    "prepublishOnly:update": "pnpm run ncu && pnpm run sort-package-json",
    "publish": "echo publish",
    "postpublishOnly": "echo postpublishOnly",
    "ncu": "yarn-tool ncu -u",
    "sort-package-json": "yarn-tool sort",
    "tsc:showConfig": "ynpx get-current-tsconfig -p"
  }
}
